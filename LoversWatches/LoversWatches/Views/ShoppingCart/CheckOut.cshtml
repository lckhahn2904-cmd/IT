@using LoversWatches.Models
@{
    ViewBag.Title = "CheckOut";
    Layout = "~/Views/Shared/_LoversWatchesLayout.cshtml";
}

<h2 class="text-center">Check Out Shopping Cart </h2>
@{
    if (Session["Cart"] != null)
    {
        <table class="table">
            <tr>
                <td>Name</td>
                <td>Quantity</td>
                <td>Price</td>
                <td>Sub Total</td>
            </tr>
            @foreach (var cart in (List<Cart>)Session["Cart"])
            {
                double p = Convert.ToDouble(cart.Product.ProPrice);
                int q = Convert.ToInt32(cart.Quantity);
                double subtotal = p * q;
                <tr>
                    <td>@cart.Product.ProName</td>
                    <td>@cart.Quantity</td>
                    <td>@Html.FormatValue(cart.Product.ProPrice, "{0:C}")</td>
                    <td>@Html.FormatValue(subtotal, "{0:C}")</td>
                </tr>
            }
            <tr>
                @{
                    List<Cart> temp = (List<Cart>)Session["Cart"];
                    var total = temp.Sum(x => x.Quantity * x.Product.ProPrice);
                }
                <td colspan="2">
                    &nbsp;
                </td>
                <td align="right">Total: </td>
                <td>@Html.FormatValue(total, "{0:C}")</td>
            </tr>
        </table>
    }
    else
    {
        <h4 class="text-center">Giỏ hàng không có sản phẩm  !</h4>
    }
}

<h3>Customer's Information</h3>
@using (Html.BeginForm("ProcessOrder", "ShoppingCart", FormMethod.Post, new { id = "customer-form" }))
{
    @*@Html.AntiForgerToken()*@
    <div class="form-horiontal">
        <hr />
        <div class="form-group">
            <label class="control-label col-md-2">Customer Name</label>
            <div class="col-md-10">
                <input type="text" name="cusPhone" class="from-control" />
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Customer Phone</label>
            <div class="col-md-10">
                <input type="text" name="cusPhone" class="from-control" />
            </div>
        </div>
        <div class="from-group">
            <label class="control-label col-md-2">Customer Email</label>
            <div class="col-md-10">
                <input type="text" name="cusEmail" class="from-control" />
            </div>
        </div>
        <div class="from-group">
            <label class="control-label col-md-2">Customer Address</label>
            <div class="col-md-10">
                <input type="text" name="cusEmail" class="from-control" />
            </div>
        </div>
        <div class="from-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Process order" class="btn btn-default" />
            </div>
        </div>
    </div>
}
<script type="text/javascript">
    $("#customer-form").validate({
        rules: {
            cusName: {
                required: true
            },
            cusPhone: {
                requied: true
            },
            cusEmail: {
                requied:
                },
            cusAddress: {
                requied: true
            }
        }
    });
</script>

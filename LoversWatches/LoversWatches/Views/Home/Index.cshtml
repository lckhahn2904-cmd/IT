            </li>
            <li class="col-sm-4">
                <a href="@Url.Action("Index","Brands")" class="item-link" title="">
                    <div class="bannerBox">
                        <img src=" ~/images/Rolex  279171.jpg" class="item-img" title="" alt="" width="100%" height="100%">
